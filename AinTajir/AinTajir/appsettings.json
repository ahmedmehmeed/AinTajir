{
  "App": {
    "SelfUrl": "https://localhost:44309",
    "ClientUrl": "http://localhost:4200",
    "CorsOrigins": "https://*.AinTajir.com,http://localhost:4200",
    "RedirectAllowedUrls": "http://localhost:4200",
    "HealthCheckUrl": "/health-status"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "Logs/logs.txt"
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Default": "Server=(LocalDb)\\MSSQLLocalDB;Database=AinTajir;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "AuthServer": {
    "Authority": "https://localhost:44309",
    "SwaggerClientId": "AinTajir_Swagger",
    "CertificatePassPhrase": "3c3ee688-9416-455e-915c-4ad1324b2110"
  },
  "Settings": {
    "Abp.Identity.Password.RequireNonAlphanumeric": "false",
    "Abp.Identity.Password.RequireLowercase": "false",
    "Abp.Identity.Password.RequireUppercase": "false",
    "Abp.Identity.Password.RequireDigit": "false"
  },
  "StringEncryption": {
    "DefaultPassPhrase": "nwlaV9WbS6wunKdX"
  },
  "OpenIddict": {
    "Applications": {
      "AinTajir_App": {
        "ClientId": "AinTajir_App",
        "RootUrl": "http://localhost:4200"
      },
      "AinTajir_Swagger": {
        "ClientId": "AinTajir_Swagger",
        "RootUrl": "https://localhost:44309"
      }
    }
  }
}
